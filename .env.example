PORT=3000
# Den adresse appen kan nås på udefra (bruges i SMS-links og til at tjekke Twilio-signaturer)
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=skift-mig

# MySQL (kører som separat service, også når den står på samme Droplet)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hittegods
DB_USER=hittegods
DB_PASSWORD=hittegods

# Twilio SMS (tom = SMS'er logges i konsollen i stedet for at blive sendt)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP til Nodemailer (tom = mails logges i konsollen i stedet for at blive sendt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Hotel Kastanje <hittegods@example.com>"

# Cloudinary til billeder af fundne ting (tom = billeder springes over)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bruges af `npm run db:admin` til at oprette den første admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@hotelkastanje.dk
ADMIN_PASSWORD=
